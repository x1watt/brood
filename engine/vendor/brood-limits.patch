diff --git a/game_types.h b/game_types.h
index d2eaa3e..1103b7f 100644
--- a/game_types.h
+++ b/game_types.h
@@ -11,24 +11,39 @@ struct sprite_t;
 struct flingy_t;
 struct unit_t;
 
+// Brood: the original packs a unit's index into 11 bits (at most 2047
+// units). Ids here are 32 bits with a 16-bit index, so the unit pool can
+// hold many more (see max_units). from_bw16() reads the original's 16-bit
+// form (replay files).
+static const size_t unit_id_index_bits = 16;
+static const size_t max_units = 10000;
+static const size_t max_sprites = 15000;
+static const size_t max_images = 30000;
+static const size_t max_orders = 12000;
+static const size_t max_bullets = 1000;
+static const size_t max_selection = 200; // units selected or in a control group at once
+
 template<typename T>
 struct unit_id_t {
 	T raw_value = 0;
 	unit_id_t() = default;
 	explicit unit_id_t(T raw_value) : raw_value(raw_value) {}
-	explicit unit_id_t(size_t index, unsigned int generation) : raw_value((T)(index | generation << 11)) {}
+	explicit unit_id_t(size_t index, unsigned int generation) : raw_value((T)(index | (T)generation << unit_id_index_bits)) {}
+	static unit_id_t from_bw16(uint16_t raw) {
+		return unit_id_t((size_t)(raw & 0x7ff), (unsigned int)(raw >> 11));
+	}
 	bool operator==(const unit_id_t& n) const {
 		return raw_value == n.raw_value;
 	}
 	size_t index() const {
-		return raw_value & 0x7ff;
+		return raw_value & ((1u << unit_id_index_bits) - 1);
 	}
 	unsigned int generation() const {
-		return raw_value >> 11;
+		return raw_value >> unit_id_index_bits;
 	}
 };
 
-using unit_id = unit_id_t<uint16_t>;
+using unit_id = unit_id_t<uint32_t>;
 using unit_id_32 = unit_id_t<uint32_t>;
 
 struct default_link_f {
