// assets/bots/standard/zerg.bot
//
// The standard Zerg player: its build plan, research and army mix.
// Rows apply in order; "ground" rows only when enemy bases can be walked
// to, "island" rows only when they can't.

// build <type> <how many in all> at <supply in use> [ground|island];
plan zerg {
	build zerg_spawning_pool 1 at 9;
	build zerg_extractor 1 at 11;
	build zerg_hatchery 2 at 13 ground;
	build zerg_lair 1 at 14 island;
	build zerg_hydralisk_den 1 at 18 ground;
	build zerg_spire 1 at 20 island;
	build zerg_evolution_chamber 1 at 22;
	build zerg_hatchery 2 at 24 island;
	build zerg_lair 1 at 28 ground;
	build zerg_hydralisk_den 1 at 30 island;
	build zerg_extractor 2 at 32;
	build zerg_spire 1 at 34 ground;
	build zerg_queens_nest 1 at 36;
	build zerg_hatchery 3 at 40 ground;
	build zerg_hive 1 at 44 island;
	build zerg_evolution_chamber 2 at 50 ground;
	build zerg_greater_spire 1 at 50 island;
	build zerg_hive 1 at 56 ground;
	build zerg_hatchery 3 at 60 island;
	build zerg_defiler_mound 1 at 64 ground;
	build zerg_ultralisk_cavern 1 at 70 ground;
	build zerg_defiler_mound 1 at 70 island;
	build zerg_greater_spire 1 at 80 ground;
	build zerg_hatchery 4 at 90;
}

// tech|upgrade <name> by <building> at <supply in use> [ground|island];
research zerg {
	upgrade metabolic_boost by zerg_spawning_pool at 14 ground;
	upgrade zerg_flyer_attacks by zerg_spire at 26 island;
	upgrade grooved_spines by zerg_hydralisk_den at 22 ground;
	upgrade muscular_augments by zerg_hydralisk_den at 26 ground;
	upgrade zerg_missile_attacks by zerg_evolution_chamber at 30 ground;
	upgrade ventral_sacs by zerg_lair at 34 island;
	tech lurker_aspect by zerg_hydralisk_den at 38 ground;
	upgrade zerg_flyer_carapace by zerg_spire at 40 island;
	tech spawn_broodlings by zerg_queens_nest at 46;
	upgrade pneumatized_carapace by zerg_lair at 50;
	upgrade zerg_carapace by zerg_evolution_chamber at 50 ground;
	tech ensnare by zerg_queens_nest at 56;
	tech plague by zerg_defiler_mound at 66;
	tech consume by zerg_defiler_mound at 70;
	upgrade ventral_sacs by zerg_lair at 70 ground;
	upgrade adrenal_glands by zerg_spawning_pool at 72 ground;
	upgrade chitinous_plating by zerg_ultralisk_cavern at 76 ground;
	upgrade anabolic_synthesis by zerg_ultralisk_cavern at 80 ground;
	upgrade zerg_flyer_attacks by zerg_spire at 80 ground;
	upgrade zerg_melee_attacks by zerg_evolution_chamber at 84 ground;
}

// <type> share <part of the army> [cap <at most>] [aa <n>/<d>] [late <share>] [cloak <share>] [some_island];
mix zerg ground {
	zerg_zergling share 20;
	zerg_hydralisk share 18;
	zerg_lurker share 6 cap 8;
	zerg_mutalisk share 10;
	zerg_ultralisk share 0 cap 8 late 6;
	zerg_defiler share 2 cap 2;
	zerg_queen share 1 cap 2;
	zerg_scourge share 0 cap 12 aa 1;
	zerg_guardian share 0 cap 10 late 5;
	zerg_devourer share 0 cap 6 aa 1/3;
}

// <type> share <part of the army> [cap <at most>] [aa <n>/<d>] [late <share>] [cloak <share>] [some_island];
mix zerg island {
	zerg_mutalisk share 18;
	zerg_scourge share 3 cap 16 aa 1;
	zerg_guardian share 10;
	zerg_devourer share 2 cap 10 aa 1/2;
	zerg_queen share 1 cap 2;
	zerg_defiler share 1 cap 1;
	zerg_hydralisk share 6 cap 12;
	zerg_zergling share 6 cap 16;
}
